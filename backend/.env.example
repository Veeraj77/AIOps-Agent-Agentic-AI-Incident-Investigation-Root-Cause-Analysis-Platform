# ============================================================
# AIOps Agent – Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!
# ============================================================

# --- LLM Configuration ---
# Groq API key – get yours free at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# LLM provider: "groq" (default)
LLM_PROVIDER=groq

# Groq model name (free tier available)
# Options: qwen/qwen3.8-27b | openai/gpt-oss-120b | llama-prompt-guard-2-86m
LLM_MODEL=qwen/qwen3.8-27b

# LLM Temperature (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.1

# --- Application Settings ---
APP_NAME=AIOps Agent
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# --- Server Settings ---
HOST=0.0.0.0
PORT=8000

# --- Database ---
DATABASE_URL=sqlite:///./storage/aiops.db

# --- ChromaDB (Vector Store) ---
CHROMA_PERSIST_DIR=./storage/chroma_db
CHROMA_COLLECTION_NAME=aiops_knowledge_base

# --- Embedding Model (Sentence Transformers – runs locally, no API key needed) ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- File Upload Limits ---
MAX_FILE_SIZE_MB=50
ALLOWED_LOG_EXTENSIONS=.log,.txt
ALLOWED_DOC_EXTENSIONS=.pdf,.txt,.md

# --- CORS (Frontend URL) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Storage Paths ---
STORAGE_DIR=./storage
UPLOAD_DIR=./storage/uploads
